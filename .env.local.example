# ===== YEEYI 亿忆 相关 =====
# 是否启用真实 YEEYI 抓取（false 时走本地 mock 数据，便于无网络/演示）
YEEYI_ENABLED=true
# YEEYI 求职招聘频道 fid（161 = 求职招聘），一般不要改
YEEYI_FID=161
# 打开求职页时默认的城市 id（1=墨尔本, 2=悉尼, ... 见 docs/yeeyi-api.md）
YEEYI_DEFAULT_CITY=1
# devid 参与接口鉴权（可选，模仿浏览器即可，如 xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx|pc）
# 留空则由服务端自动生成一个稳定的匿名 devid
YEEYI_DEVID=

# ===== 大模型（位置解析 & AI 筛选）=====
# 采用 OpenAI 兼容的 Chat Completions 协议，OpenAI / DeepSeek / Moonshot 等均可。
# 协议基地址，例如 https://api.deepseek.com/v1 或 https://api.openai.com/v1
LLM_BASE_URL=
# 模型名称，例如 deepseek-chat / gpt-4o-mini
LLM_MODEL=deepseek-chat
# API Key —— 切勿提交真实密钥到仓库
LLM_API_KEY=
# 无 key 时是否允许使用“启发式兜底”解析/筛选（true 则无 key 也能演示完整流程）
LLM_FALLBACK_ENABLED=true

# ===== 地图（Leaflet + OpenStreetMap，无需 key）=====
# Leaflet 使用免费 OpenStreetMap 瓦片，无需 API key。
# 若未来切换到 Mapbox/Google，可在此追加：
MAPBOX_ACCESS_TOKEN=
